# ⚠️ CE FICHIER NE DOIT JAMAIS ÊTRE COMMITÉ ⚠️
# Les vraies valeurs doivent être dans Render Environment Variables UNIQUEMENT
# Ce fichier est un exemple pour le développement local
#
# Le front se configure avec .env.example (variables VITE_*) : elles sont lues
# par le BUILD Vite, pas par ce backend (P14 C4, audit-3).

PORT=4001
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# PAS de SUPABASE_ANON_KEY : supabase.mjs refuse volontairement tout repli sur
# la clé anon — le serveur écrit avec la clé service_role (qui contourne les RLS).
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
ZOYD_ALLOWED_ORIGINS=https://zoyd.vercel.app
# En developpement local (NODE_ENV different de production), les origines du
# front Vite (http://localhost:5173 et http://127.0.0.1:5173) sont AJOUTEES a
# cette liste : les poser ici ne les remplace pas. Ne les ecris PAS dans cette
# variable — en production (NODE_ENV=production) elles ne sont de toute facon
# pas ajoutees, et le garde CSRF comme le handshake WebSocket s'appuient sur
# cette liste.
FEDAPAY_SECRET_KEY=sk_sandbox_YOUR_KEY
# Secret du endpoint webhook FedaPay (Workbench → Webhooks, `wh_...`).
# SANS lui, POST /api/webhooks/fedapay repond 503 (fail-closed) : le
# webhook est inactif, le cron de reconciliation reste le filet.
FEDAPAY_WEBHOOK_SECRET=wh_YOUR_WEBHOOK_SECRET
# Obligatoire en production : sans lui /api/metrics répond 403 METRICS_DISABLED.
METRICS_TOKEN=CHANGE_ME_TO_LONG_RANDOM_TOKEN
# Chiffrement au repos des secrets TOTP admin (OBLIGATOIRE en prod).
# Sans lui, le serveur REFUSE d'ecrire un secret 2FA (jamais en clair).
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ZOYD_2FA_ENC_KEY=CHANGE_ME_TO_32_BYTES_BASE64
# Rotation de cle : definir NEXT, deployer, attendre une connexion admin
# (le secret est reecrit au chargement), puis supprimer KEY et renommer NEXT.
# ZOYD_2FA_ENC_KEY_NEXT=
ZOYD_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD
# Identité du compte de modération à SURCHARGER : les défauts du code
# (admin@zoyd.com / ZOYD Control / admin-zoyd-control) sont publics.
# ZOYD_ADMIN_EMAIL=votre-email@votre-domaine
# ZOYD_ADMIN_PSEUDO=VotrePseudoAdmin
# ZOYD_ADMIN_ID=votre-identifiant-admin
# Téléphone du compte de modération. Le défaut du code (+2290161000001) est
# PUBLIC : c'est un numéro de démonstration, et l'argent ne peut pas y être
# envoyé (le serveur refuse). Le compte admin ne peut donc pas retirer
# avant que ce numéro soit changé.
# ZOYD_ADMIN_PHONE=+229XXXXXXXX
# NODE_ENV : render.yaml pose production côté prod. En local, NE RIEN POSER —
# forcer production verrouille les gardes de test et les logs lisibles.
# Email via API HTTPS (Render gratuit bloque SMTP ports 25/465/587).
# Resend (recommandé) : https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_KEY
# Alternative Brevo : https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=xkeysib_YOUR_KEY
EMAIL_FROM=ZOYD <onboarding@resend.dev>
# SMTP gardé pour dev local uniquement
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM=ZOYD <you@gmail.com>
# Debug local : expose tokens/codes en réponse + logs (JAMAIS en prod)
# ALLOW_DEBUG_CODES=true
