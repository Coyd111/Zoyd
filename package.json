{
  "name": "zoyd-gaming-infrastructure",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:client": "vite",
    "dev:realtime": "node server/realtime-server.mjs",
    "dev:full": "node server/dev-runner.mjs",
    "start": "node server/realtime-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src server e2e --ext .ts,.tsx,.mjs --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --config=playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config=playwright.config.ts --ui",
    "test:e2e:live": "npx playwright test --config=playwright.config.ts --project=live-api",
    "test:e2e:live-ui": "npx playwright test --config=playwright.config.ts --project=live-ui",
    "test:e2e:live-all": "npx playwright test --config=playwright.config.ts --project=live-api --project=live-ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@supabase/supabase-js": "^2.118.0",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.4.2",
    "fedapay": "^1.2.5",
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.14.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "4.1.12",
    "typescript": "~5.6.3",
    "vite": "6.3.5",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
