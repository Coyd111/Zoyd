{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(auth|mode|mj|wallet|earnings|classements|chat|profil|parametres|br-league|infos|admin)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.fedapay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.fedapay.com; img-src 'self' data: blob: https://cdn.fedapay.com; connect-src 'self' wss://zoyd.onrender.com https://zoyd.onrender.com https://cdn.fedapay.com https://api.fedapay.com https://checkout.fedapay.com https://sandbox-checkout.fedapay.com https://process.fedapay.com https://sandbox-process.fedapay.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.fedapay.com; media-src 'self' blob: data: https://cdn.fedapay.com; frame-src https://checkout.fedapay.com https://sandbox-checkout.fedapay.com https://process.fedapay.com https://sandbox-process.fedapay.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.fedapay.com https://sandbox-checkout.fedapay.com https://process.fedapay.com https://sandbox-process.fedapay.com" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "/index.html" },
    { "source": "/conditions", "destination": "/index.html" },
    { "source": "/reglement-litiges", "destination": "/index.html" },
    { "source": "/anti-fraude", "destination": "/index.html" },
    { "source": "/confidentialite", "destination": "/index.html" },
    { "source": "/mentions", "destination": "/index.html" },
    { "source": "/jeu-responsable", "destination": "/index.html" },
    { "source": "/mode", "destination": "/index.html" },
    { "source": "/mj(.*)", "destination": "/index.html" },
    { "source": "/wallet", "destination": "/index.html" },
    { "source": "/earnings", "destination": "/index.html" },
    { "source": "/classements", "destination": "/index.html" },
    { "source": "/chat", "destination": "/index.html" },
    { "source": "/profil(.*)", "destination": "/index.html" },
    { "source": "/parametres", "destination": "/index.html" },
    { "source": "/br-league(.*)", "destination": "/index.html" },
    { "source": "/infos", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
